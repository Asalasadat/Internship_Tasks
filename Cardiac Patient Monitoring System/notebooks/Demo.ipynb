      "cell_type": "code",
      "source": [
        "# 1. Expected maximum heart rate\n",
        "df['expected_max_hr'] = 220 - df['age']\n",
        "\n",
        "# 2. Maximum heart rate as percentage of expected maximum\n",
        "df['hr_ratio'] = df['thalch'] / df['expected_max_hr']\n",
        "\n",
        "# 3. Blood pressure relative to age\n",
        "df['bp_age_ratio'] = df['trestbps'] / df['age']\n",
        "\n",
        "# 4. Cholesterol relative to age\n",
        "df['chol_age_ratio'] = df['chol'] / df['age']\n",
        "\n",
        "# 5. Blood pressure × cholesterol interaction\n",
        "df['bp_chol_interaction'] = df['trestbps'] * df['chol']"
      ],
