        "from tensorflow.keras.layers import Input, Dense, Dropout, BatchNormalization\n",
        "\n",
        "results = []\n",
        "\n",
        "# Base configuration\n",
        "configs = [\n",
        "    (\"Baseline\", 0.001, 64, 32, 0.30, 0.20, 32),\n",
        "\n",
        "    # Change learning rate only\n",
        "    (\"LR 0.0001\", 0.0001, 64, 32, 0.30, 0.20, 32),\n",
        "    (\"LR 0.01\",   0.01,   64, 32, 0.30, 0.20, 32),\n",
        "\n",
        "    # Change network size only\n",
        "    (\"Larger Network\", 0.001, 128, 64, 0.30, 0.20, 32),\n",
        "\n",
        "    # Change dropout only\n",
        "    (\"Higher Dropout\", 0.001, 64, 32, 0.40, 0.30, 32),\n",
        "\n",
        "    # Change batch size only\n",
        "    (\"Batch Size 16\", 0.001, 64, 32, 0.30, 0.20, 16),\n",
        "]\n",
        "\n",
        "for name, lr, units1, units2, drop1, drop2, batch_size in configs:\n",
        "\n",
        "    model = Sequential([\n",
        "        Input(shape=(X_train_scaled.shape[1],)),\n",
        "\n",
        "        Dense(units1, activation=\"relu\"),\n",
        "        BatchNormalization(),\n",
        "        Dropout(drop1),\n",
        "\n",
        "        Dense(units2, activation=\"relu\"),\n",
        "        Dropout(drop2),\n",
        "\n",
        "        Dense(1, activation=\"sigmoid\")\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=lr),\n",
        "        loss=\"binary_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "\n",
        "    history = model.fit(\n",
        "        X_train_scaled,\n",
        "        y_train,\n",
        "        validation_data=(X_val_scaled, y_val),\n",
        "        epochs=50,\n",
        "        batch_size=batch_size,\n",
        "        verbose=0\n",
        "    )\n",
        "\n",
        "    best_val_loss = min(history.history[\"val_loss\"])\n",
        "    best_val_accuracy = max(history.history[\"val_accuracy\"])\n",
        "\n",
        "    results.append({\n",
        "        \"Run\": name,\n",
        "        \"Learning Rate\": lr,\n",
        "        \"Hidden Layers\": f\"{units1}, {units2}\",\n",
        "        \"Dropout\": f\"{drop1}, {drop2}\",\n",
        "        \"Batch Size\": batch_size,\n",
        "        \"Best Validation Loss\": best_val_loss,\n",
        "        \"Best Validation Accuracy\": best_val_accuracy\n",
        "    })\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "results_df"
      ],
